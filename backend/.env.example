# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/phishguard?retryWrites=true&w=majority
MONGO_URI=

# Authentication Secret
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Initial Administrator Seed Credentials (Used by: npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
